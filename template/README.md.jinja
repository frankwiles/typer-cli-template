│       ├── hello.py
│       └── api/
│           └── get.py
├── domain/
│   └── errors.py         # AppError and domain errors
└── infrastructure/
    └── http_client.py    # HTTP client wrapper
```

## Adding New Commands

{% if use_commands_folder %}
1. Create a new file in `cli/commands/` or a subdirectory
2. Define `app = typer.Typer()` in the module
3. Add commands with `@app.command()` decorator

Example:

```python
# cli/commands/mycommand.py
import typer
from {{ package_name }}.cli.ui.console import ok

app = typer.Typer()

@app.command()
def greet(name: str) -> None:
    """Greet someone."""
    ok(f"Hello, {name}!")
```

This automatically becomes available as `{{ cli_name }} mycommand greet`.
{% else %}
Add new commands by modifying the `cli/app.py` file.
{% endif %}

